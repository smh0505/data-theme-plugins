{
  "id": "brick-block-data-theme",
  "name": "Brick Block (Data)",
  "version": "1.3.0",
  "kind": "theme",
  "cssVariables": {
    "--color-base": "#5c94fc",
    "--color-mantle": "#a4e4fc",
    "--color-crust": "#0058f8",
    "--color-text": "#1a1a2e",
    "--color-subtext": "#3a3a5e",
    "--color-surface0": "#c84c0c",
    "--color-surface1": "#7c2c00",
    "--color-accent": "#e52521",
    "--color-accent-alt": "#43b047",
    "--color-danger": "#b71c1c",
    "--color-button-text": "#ffffff",
    "--color-on-accent": "#ffffff",
    "--button-border-width": "3px",
    "--button-border-color": "#7c2c00",
    "--button-radius": "0",
    "--balloon-border-width": "2px",
    "--balloon-radius": "0",
    "--balloon-background": "var(--color-mantle)",
    "--balloon-font-family": "'Fusion Pixel 12px Prop ko', 'Press Start 2P', Inter, Avenir, Helvetica, Arial, sans-serif",
    "--card-border-width": "3px",
    "--card-radius": "0",
    "--cover-placeholder-background": "repeating-linear-gradient(45deg, #c84c0c, #c84c0c 10px, #7c2c00 10px, #7c2c00 12px)",
    "--cover-placeholder-color": "#fce303",
    "--cover-placeholder-text-shadow": "2px 2px 0 #7c2c00",
    "--cover-placeholder-font-size": "2.5rem",
    "--tile-background": "repeating-linear-gradient(45deg, #c84c0c, #c84c0c 12px, #7c2c00 12px, #7c2c00 14px)",
    "--tile-border-width": "4px",
    "--tile-border-color": "var(--color-surface1)",
    "--tile-title-font-family": "'Fusion Pixel 12px Prop ko', 'Press Start 2P', Inter, Avenir, Helvetica, Arial, sans-serif",
    "--tile-title-text-shadow": "2px 2px 0 #000"
  },
  "cardVisual": {
    "type": "if",
    "test": { "field": "cover_art_url" },
    "then": {
      "type": "image",
      "class": "cover",
      "src": { "field": "cover_art_url" },
      "alt": { "field": "title" }
    },
    "else": {
      "type": "element",
      "tag": "div",
      "class": "cover-placeholder",
      "children": [{ "type": "text", "content": "★" }]
    }
  },
  "fontFaces": [
    {
      "family": "Fusion Pixel 12px Prop ko",
      "url": "https://raw.githubusercontent.com/smh0505/data-theme-plugins/204a142ffe3a113f888711b2ca023679f5b0c99d/themes/brick-block-data-theme/fusion-pixel-12px-proportional-ko.otf.woff2"
    }
  ],
  "fonts": [
    {
      "name": "Fusion Pixel Font (12px Proportional Korean)",
      "author": "TakWolf",
      "url": "https://github.com/TakWolf/fusion-pixel-font",
      "license": "OFL-1.1"
    }
  ]
}
